{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/scout/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "apps/scout/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/scout",
  "projects": {
    "scout": {
      "type": "application",
      "root": "apps/scout",
      "entryFile": "main",
      "sourceRoot": "apps/scout/src",
      "compilerOptions": {
        "tsConfigPath": "apps/scout/tsconfig.app.json",
        "assets": [
          {
            "include": "../prompts/**/*.md",
            "outDir": "dist/apps/scout/prompts",
            "watchAssets": true
          }
        ]
      }
    }
  }
}
