# Sentry.
# Warning: an organization token (the `sntrys_` kind) does NOT work here. Its scope is
# fixed to org:ci, and four endpoints scout needs reject it. Use an internal integration
# token or a user auth token, with event:read, org:read and project:releases.
SENTRY_TOKEN=
SENTRY_ORG=your-org-slug
SENTRY_ENVIRONMENT=staging
SENTRY_BASE_URL=https://sentry.io

# GitHub. A token that can read the target repositories.
GITHUB_TOKEN=

# The model gateway. Any OpenAI-compatible or Anthropic-Messages endpoint.
# Warning: do not use the provider identifier `anthropic`. That name triggers hard-coded
# beta headers that an open-weights gateway may reject.
MODEL_PROVIDER_ID=gateway
MODEL_PROVIDER_NPM=@ai-sdk/openai-compatible
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_ID=qwen3-coder
MODEL_API_KEY=

# Budgets. We count tokens, not money: OpenCode reports a cost of zero for a custom
# provider. See gap 3 in GAPS.md.
MAX_TOKENS=500000
MAX_TOOL_CALLS=40
MAX_RUN_MS=1800000

# Paths.
WORK_DIR=./work
OPENCODE_PORT=4096
PORT=3000
